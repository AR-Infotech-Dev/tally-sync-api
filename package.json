{
  "name": "Flowups - Tally Sync API",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "type": "module",
  "imports": {
    "#config/*": "./src/config/*",
    "#middlewares/*": "./src/middlewares/*",
    "#modules/*": "./src/modules/*",
    "#routes/*": "./src/routes/*",
    "#shared/*": "./src/shared/*",
    "#socket/*": "./src/socket/*"
  },
  "description": "Express migration scaffold for the legacy CodeIgniter API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "check:imports": "node --input-type=module -e \"await import('./src/app.js')\"",
    "start": "node src/server.js",
    "routes": "node src/scripts/printRoutes.js",
    "client:create": "node src/scripts/createClient.js",
    "email:verify": "node src/scripts/verifyEmail.js"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "handlebars": "^4.7.9",
    "mongodb": "^7.7.0",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.16",
    "puppeteer": "^25.16.0",
    "socket.io": "^4.8.3"
  }
}
