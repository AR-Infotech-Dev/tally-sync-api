{
  "name": "Flowups - Tally Sync API",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true,
  "type": "module",
  "imports": {
    "#config/*": "./src/config/*",
    "#middlewares/*": "./src/middlewares/*",
    "#modules/*": "./src/modules/*",
    "#routes/*": "./src/routes/*",
    "#shared/*": "./src/shared/*",
    "#socket/*": "./src/socket/*"
  },
  "description": "Express migration scaffold for the legacy CodeIgniter API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "routes": "node src/scripts/printRoutes.js",
    "client:create": "node src/scripts/createClient.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "handlebars": "^4.7.9",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.3",
    "nodemailer": "^10.0.16",
    "socket.io": "^4.8.3"
  }
}
