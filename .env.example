PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=tally_sync
# Max time CRM push endpoints wait for the Connector/Tally terminal response (milliseconds).
CONNECTOR_RESPONSE_TIMEOUT_MS=120000
# Terminal Sales requests expire this many days after success/failure.
REQUEST_RETENTION_DAYS=90
# Sales PDF files use their own retention window after export.
SALES_PDF_RETENTION_DAYS=90
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
# Optional override. Leave unset for automatic PDF browser installation/discovery.
# PDF_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
# PDF_BROWSER_CACHE_DIR=/app/.cache/pdf-browser
# Debian/Ubuntu root build only: install Chrome's Linux packages automatically.
# PDF_BROWSER_INSTALL_DEPS=true
