PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=tally_sync
# Max time CRM push endpoints wait for the Connector/Tally terminal response (milliseconds).
CONNECTOR_RESPONSE_TIMEOUT_MS=120000
CONNECTOR_HEALTH_TIMEOUT_MS=5000
CONNECTOR_PING_TIMEOUT_MS=1500
LEDGER_RESPONSE_TIMEOUT_MS=15000
# Terminal Sales requests expire this many days after success/failure.
REQUEST_RETENTION_DAYS=90
# Sales PDF files use their own retention window after export.
SALES_PDF_RETENTION_DAYS=90
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
# Build-publishing key: generate a random value (at least 32 characters), then use
# the same value in Connector/.env.release. This is separate from client API keys.
CONNECTOR_RELEASE_TOKEN=
# Installer storage must be on a persistent volume in production.
# Default when omitted: Server/storage/connector-releases
CONNECTOR_RELEASES_DIR=
CONNECTOR_RELEASE_MAX_MB=300
