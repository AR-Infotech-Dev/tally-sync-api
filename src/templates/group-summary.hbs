<!doctype html>
<html>

<head>
    <meta charset="utf-8">
    <title>{{group}} - Group Summary</title>
</head>
<style>
    /* Print styles for this report. Edit the layout here. */
    html {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    body {
        font-family: Report-latin, Report-devanagari, sans-serif;
        font-size: 14px;
        line-height: 1.3;
        color: #111;
        margin: 0;
    }

    h1 {
        font-size: 20px;
        margin: 0 0 3px;
    }

    h2 {
        font-size: 16px;
        margin: 0 0 8px;
    }

    p {
        margin: 0 0 3px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 12px;
        table-layout: auto;
    }

    thead {
        display: table-header-group;
    }

    tfoot {
        display: table-footer-group;
    }

    tr {
        break-inside: avoid;
    }

    th,
    td {
        padding: 4px 5px;
        vertical-align: top;
        overflow-wrap: anywhere;
    }

    /* 
th {
    background: white;
    border-top: 1px solid #444;
    border-bottom: 1px solid #444;
} */

    th:first-child,
    td:first-child {
        text-align: left;
    }

    .number,
    .amount {
        text-align: right;
        white-space: nowrap;
    }

    .border-top {
        border-top: 1px solid #444;
    }

    .muted,
    .narration,
    .type,
    .note {
        color: #666;
        font-size: 12px;
    }

    .stale {
        color: #8d5900;
        background: #fff5df;
    }

    .report-heading {
        margin: 8px 0 12px;
        text-align: center;
    }

    .indent {
        padding-left: 20px;
    }

    .group-summary thead th {
        border: 1px solid #444;
    }

    .border-top {
        border-top: 1px solid #000 !important
    }

    .number {
        text-align: right
    }

</style>

<body class="group-summary">
    {{#if show_company_name}}
    <h1 style="text-align:center">{{company}}</h1>
    {{/if}}
    {{#if show_company_address}}

    {{#each company_address}}
    <p style="text-align:center;margin:0 0 2px">{{this}}</p>
    {{/each}}

    {{#if company_email}}
    <p style="text-align:center;margin:0 0 8px">E-Mail: {{company_email}}</p>
    {{/if}}

    {{/if}}
    <p style="text-align:center;margin:8px 0 0"><strong>{{group}}</strong><br>Group Summary</p>
    <p style="text-align:center;margin:4px 0 16px">{{from_date}} to {{to_date}}</p>
    <table>
        <thead>
            <tr class="border-top border-l-0 border-r-0">
                <th class="border-0"></th>
                {{#if show_opening_balance}}
                <th colspan="2" style="text-align:center">Opening<br>Balance</th>
                {{/if}}

                {{#if show_transactions}}
                <th colspan="2" style="text-align:center">Transactions</th>
                {{/if}}

                {{#if
                show_closing_balance}}
                <th colspan="2" style="text-align:center">Closing<br>Balance</th>
                {{/if}}
            </tr>
            <tr>
                <th class="border-t-0 border-l-0"></th>
                {{#if show_opening_balance}}
                <th>Debit</th>
                <th>Credit</th>
                {{/if}}

                {{#if show_transactions}}
                <th>Debit</th>
                <th>Credit</th>
                {{/if}}

                {{#if show_closing_balance}}
                <th>Debit</th>
                <th>Credit</th>
                {{/if}}
            </tr>
        </thead>
        <tbody>
            {{#each rows}}
            <tr>
                <td>{{ledger_name}}</td>
                {{#if @root.show_opening_balance}}
                <td class="number">{{opening_debit}}</td>
                <td class="number">{{opening_credit}}</td>
                {{/if}}

                {{#if @root.show_transactions}}
                <td class="number">
                    {{transaction_debit}}</td>
                <td class="number">{{transaction_credit}}</td>
                {{/if}}

                {{#if @root.show_closing_balance}}
                <td class="number">{{closing_debit}}</td>
                <td class="number">{{closing_credit}}</td>
                {{/if}}
            </tr>
            {{/each}}
            <tr>
                <td class="border-top"><strong>Grand Total</strong></td>
                {{#if show_opening_balance}}
                <td class="number border-top"><strong>{{grand_opening_debit}}</strong></td>
                <td class="number border-top"><strong>{{grand_opening_credit}}</strong></td>
                {{/if}}

                {{#if show_transactions}}
                <td class="number border-top">
                    <strong>{{grand_transaction_debit}}</strong>
                </td>
                <td class="number border-top"><strong>{{grand_transaction_credit}}</strong></td>
                {{/if}}

                {{#if
                show_closing_balance}}
                <td class="number border-top"><strong>{{grand_closing_debit}}</strong></td>
                <td class="number border-top"><strong>{{grand_closing_credit}}</strong></td>
                {{/if}}
            </tr>
        </tbody>
    </table>
</body>

</html>
