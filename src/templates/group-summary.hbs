<!doctype html>
<html>

<head>
    <meta charset="utf-8">
    <title>{{group}} - Group Summary</title>
</head>
<style>
    .border-top {
        border-top: 1px solid #000 !important
    }

    .number {
        text-align: right
    }
</style>

<body>
    {{#if show_company_name}}<h1 style="text-align:center">{{company}}</h1>{{/if}}
    {{#if show_company_address}}{{#each company_address}}<p style="text-align:center;margin:0 0 2px">{{this}}</p>
    {{/each}}{{#if company_email}}<p style="text-align:center;margin:0 0 8px">E-Mail: {{company_email}}</p>
    {{/if}}{{/if}}
    <p style="text-align:center;margin:8px 0 0"><strong>{{group}}</strong><br>Group Summary</p>
    <p style="text-align:center;margin:4px 0 16px">{{from_date}} to {{to_date}}</p>
    <table data-pdfmake='{"widths":{{table_widths}},"headerRows":2,"layout":"groupSummary"}'>
        <thead>
            <tr>
                <th></th>{{#if show_opening_balance}}<th colspan="3" style="text-align:center">Opening<br>Balance</th>
                {{/if}}{{#if show_transactions}}<th colspan="2" style="text-align:center">Transactions</th>{{/if}}{{#if
                show_closing_balance}}<th colspan="3" style="text-align:center">Closing<br>Balance</th>{{/if}}
            </tr>
            <tr>
                <th></th>{{#if show_opening_balance}}<th>Debit</th>
                <th>Credit</th>
                <th>%</th>{{/if}}{{#if show_transactions}}<th>Debit</th>
                <th>Credit</th>{{/if}}{{#if show_closing_balance}}<th>Debit</th>
                <th>Credit</th>
                <th>%</th>{{/if}}
            </tr>
        </thead>
        <tbody>
            {{#each rows}}<tr>
                <td>{{ledger_name}}</td>{{#if @root.show_opening_balance}}<td class="number">{{opening_debit}}</td>
                <td class="number">{{opening_credit}}</td>
                <td class="number">{{opening_percentage}}</td>{{/if}}{{#if @root.show_transactions}}<td class="number">
                    {{transaction_debit}}</td>
                <td class="number">{{transaction_credit}}</td>{{/if}}{{#if @root.show_closing_balance}}<td
                    class="number">{{closing_debit}}</td>
                <td class="number">{{closing_credit}}</td>
                <td class="number">{{closing_percentage}}</td>{{/if}}
            </tr>{{/each}}
            <tr>
                <td class="border-top"><strong>Grand Total</strong></td>{{#if show_opening_balance}}<td
                    class="number border-top"><strong>{{grand_opening_debit}}</strong></td>
                <td class="number border-top"><strong>{{grand_opening_credit}}</strong></td>
                <td class="number border-top"></td>{{/if}}{{#if show_transactions}}<td class="number border-top">
                    <strong>{{grand_transaction_debit}}</strong></td>
                <td class="number border-top"><strong>{{grand_transaction_credit}}</strong></td>{{/if}}{{#if
                show_closing_balance}}<td class="number border-top"><strong>{{grand_closing_debit}}</strong></td>
                <td class="number border-top"><strong>{{grand_closing_credit}}</strong></td>
                <td class="number border-top"></td>{{/if}}
            </tr>
        </tbody>
    </table>
</body>

</html>