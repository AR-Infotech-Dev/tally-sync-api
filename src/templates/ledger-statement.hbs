<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>Ledger statement - {{ledger_name}}</title></head>
<body>
  <h1>{{company}}</h1>
  <h2>LEDGER STATEMENT</h2>
  <p class="ledger">{{ledger_name}}</p>
  <p>{{from_date}} to {{to_date}}</p>
  <p>Opening balance: <strong>{{opening_balance}}</strong><br>Closing balance: <strong>{{closing_balance}}</strong></p>
  {{#if is_stale}}<p class="stale">Cached data - latest Tally changes may not be included.</p>{{/if}}
  <table data-pdfmake='{"widths":[49,73,"*",57,57,74],"headerRows":1,"layout":"lightHorizontalLines"}'>
    <thead><tr><th>Date</th><th>Voucher / Type</th><th>Particulars / Narration</th><th class="number">Debit</th><th class="number">Credit</th><th class="number">Balance</th></tr></thead>
    <tbody>
      {{#each entries}}
      <tr>
        <td>{{date}}</td>
        <td>{{voucher_no}}<br><span class="type">{{voucher_type}}</span></td>
        <td>{{particulars}}{{#if narration}}<br><span class="narration">{{narration}}</span>{{/if}}</td>
        <td class="number">{{debit}}</td><td class="number">{{credit}}</td><td class="number">{{balance}}</td>
      </tr>
      {{else}}
      <tr><td colspan="6" style="text-align:center;color:#69768a">No transactions in this period.</td></tr>
      {{/each}}
      <tr><td colspan="3" style="background-color:#f3f6fb"><strong>Period totals</strong></td><td class="number"><strong>{{total_debit}}</strong></td><td class="number"><strong>{{total_credit}}</strong></td><td></td></tr>
      <tr><td colspan="5" style="background-color:#f3f6fb"><strong>Closing balance</strong></td><td class="number"><strong>{{closing_balance}}</strong></td></tr>
    </tbody>
  </table>
  <p class="note">Amounts in company base currency.</p>
</body></html>
