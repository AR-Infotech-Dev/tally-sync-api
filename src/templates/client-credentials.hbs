<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>Your Tally Sync Connector credentials</title>
  <style>
    body { margin:0; padding:0; }
    table { border-collapse:collapse; }
    @media only screen and (max-width:640px) {
      .outer-padding { padding:16px 10px !important; }
      .content-padding { padding:20px 14px !important; }
      .stack { display:block !important; width:100% !important; box-sizing:border-box !important; }
      .section-content { padding:0 0 16px !important; }
      .status { text-align:left !important; padding-top:14px !important; }
      .hello { font-size:25px !important; }
      .footer-contact { padding:14px 0 0 !important; border-left:0 !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#f5f7fb;color:#142039;font-family:Arial,Helvetica,sans-serif;">
{{#*inline "credentialBox"}}
  <table role="presentation" width="100%" style="width:100%;margin-bottom:10px;border:1px solid #ccddf6;border-radius:6px;background:#ffffff;">
    <tr><td style="padding:10px 12px 7px;font-size:12px;line-height:18px;font-weight:bold;color:#101a35;">{{label}}</td></tr>
    <tr><td style="padding:10px 12px;border-top:1px solid #e2eaf6;background:#f8fbff;font-family:'Courier New',monospace;font-size:13px;line-height:21px;word-break:break-all;overflow-wrap:anywhere;user-select:all;">{{value}}</td></tr>
  </table>
{{/inline}}
  <div style="display:none;font-size:1px;line-height:1px;color:#f5f7fb;max-height:0;max-width:0;opacity:0;overflow:hidden;">Your account is ready. Complete Connector activation and keep your API credentials private.</div>
  <table role="presentation" width="100%" style="width:100%;background:#f5f7fb;">
    <tr><td class="outer-padding" align="center" style="padding:28px 16px;">
      <table role="presentation" width="960" style="width:100%;max-width:960px;background:#ffffff;">
        <tr><td class="content-padding" style="padding:30px 32px;">
          <table role="presentation" width="100%" style="width:100%;">
            <tr>
              <td class="stack" width="58%" style="width:58%;vertical-align:middle;">
                <table role="presentation"><tr>
                  <td width="44" align="center" style="width:44px;height:44px;background:#12bce9;border-radius:10px;color:#ffffff;font-size:33px;line-height:44px;font-weight:bold;">F</td>
                  <td style="padding-left:12px;"><span style="font-size:28px;line-height:31px;font-weight:bold;color:#071536;">FlowupS</span><br><span style="font-size:14px;line-height:21px;color:#535e76;">Technologies Pvt. Ltd.</span></td>
                </tr></table>
              </td>
              <td class="stack status" width="42%" align="right" style="width:42%;text-align:right;vertical-align:middle;">
                <span style="font-size:11px;line-height:21px;letter-spacing:1.4px;color:#535e76;">TALLY INTEGRATION</span><br>
                <span style="font-size:13px;line-height:22px;font-weight:bold;color:#079c55;">Account Created Successfully &#10003;</span>
              </td>
            </tr>
          </table>
          <table role="presentation" width="100%"><tr><td height="22" style="height:22px;border-bottom:1px solid #dfe5ef;"></td></tr></table>

          <h1 class="hello" style="margin:22px 0 8px;font-size:28px;line-height:35px;color:#071536;">Hello <span style="color:#1265f5;">{{name}}</span>,</h1>
          <p style="margin:0 0 5px;font-size:17px;line-height:26px;">Your Tally Sync account has been created successfully.</p>
          <p style="margin:0 0 20px;font-size:14px;line-height:22px;color:#535e76;">Please follow the details below to complete the setup and start syncing your Tally data.</p>

          <table role="presentation" width="100%" style="width:100%;border:1px solid #d3e7ff;background:#f0f8ff;border-radius:9px;">
            <tr><td style="padding:17px 16px;">
              <table role="presentation" width="100%"><tr>
                <td width="44" style="width:44px;vertical-align:top;"><table role="presentation"><tr><td align="center" style="width:34px;height:34px;border-radius:50%;background:#1265f5;color:#ffffff;font-size:20px;line-height:34px;font-weight:bold;">1</td></tr></table></td>
                <td style="vertical-align:top;">
                  <table role="presentation" width="100%"><tr>
                    <td class="stack section-content" width="54%" style="width:54%;padding-right:18px;vertical-align:top;">
                      <h2 style="margin:0 0 3px;font-size:18px;line-height:25px;color:#071536;">Connector Setup</h2>
                      <p style="margin:0 0 12px;font-size:14px;line-height:21px;color:#3d4b67;">On the computer running TallyPrime</p>
                      <ol style="margin:0;padding-left:19px;font-size:13px;line-height:21px;color:#3d4b67;">
                        <li>Open Connector Setup.</li><li>Paste the activation code below.</li><li>It expires in 24 hours and can be used once.</li><li>Then test Tally, select your company and wait for the first sync to complete.</li>
                      </ol>
                    </td>
                    <td class="stack" width="46%" style="width:46%;vertical-align:middle;">
                      {{> credentialBox label="Activation Code" value=activation_code}}
                      <p style="margin:0;font-size:12px;line-height:19px;color:#1265f5;">Expires in 24 hours &nbsp;|&nbsp; Can be used once</p>
                    </td>
                  </tr></table>
                </td>
              </tr></table>
            </td></tr>
          </table>
          <table role="presentation"><tr><td height="14" style="height:14px;"></td></tr></table>

          <table role="presentation" width="100%" style="width:100%;border:1px solid #dbefe5;background:#eff9f4;border-radius:9px;">
            <tr><td style="padding:17px 16px;">
              <table role="presentation" width="100%"><tr>
                <td width="44" style="width:44px;vertical-align:top;"><table role="presentation"><tr><td align="center" style="width:34px;height:34px;border-radius:50%;background:#0aa15b;color:#ffffff;font-size:20px;line-height:34px;font-weight:bold;">2</td></tr></table></td>
                <td style="vertical-align:top;">
                  <table role="presentation" width="100%"><tr>
                    <td class="stack section-content" width="54%" style="width:54%;padding-right:18px;vertical-align:top;">
                      <h2 style="margin:0 0 3px;font-size:18px;line-height:25px;color:#071536;">Application API Credentials</h2>
                      <p style="margin:0 0 12px;font-size:14px;line-height:21px;color:#3d4b67;">For your backend or Postman</p>
                      <ol style="margin:0;padding-left:19px;font-size:13px;line-height:21px;color:#3d4b67;">
                        <li>Use these credentials in your backend.</li><li>The API key is your secret.</li><li>There is no separate API Secret field.</li><li>Keep it in your backend environment or a private Postman environment.</li><li>Do not put it in browser code.</li>
                      </ol>
                    </td>
                    <td class="stack" width="46%" style="width:46%;vertical-align:middle;">
                      {{> credentialBox label="X-Client-ID" value=client_id}}
                      {{> credentialBox label="X-API-Key" value=api_key}}
                      <p style="margin:0;font-size:11px;line-height:17px;color:#535e76;">Select the credential text to copy it.</p>
                    </td>
                  </tr></table>
                </td>
              </tr></table>
            </td></tr>
          </table>
          <table role="presentation"><tr><td height="14" style="height:14px;"></td></tr></table>

          <table role="presentation" width="100%" style="width:100%;border:1px solid #f5e8d8;background:#fff6eb;border-radius:9px;">
            <tr><td style="padding:17px 16px;">
              <table role="presentation" width="100%"><tr>
                <td width="44" style="width:44px;vertical-align:top;"><table role="presentation"><tr><td align="center" style="width:34px;height:34px;border-radius:50%;background:#ff8300;color:#ffffff;font-size:20px;line-height:34px;font-weight:bold;">3</td></tr></table></td>
                <td style="vertical-align:top;">
                  <table role="presentation" width="100%"><tr>
                    <td class="stack section-content" width="54%" style="width:54%;padding-right:18px;vertical-align:top;">
                      <h2 style="margin:0 0 3px;font-size:18px;line-height:25px;color:#071536;">Manual Connector Setup</h2>
                      <p style="margin:0 0 12px;font-size:14px;line-height:21px;color:#3d4b67;">Only if activation fails or the code has expired</p>
                      <ol style="margin:0;padding-left:19px;font-size:13px;line-height:21px;color:#3d4b67;">
                        <li>Enter these details in Connector Settings.</li><li>The Connector Key is different from the application API key.</li>
                      </ol>
                    </td>
                    <td class="stack" width="46%" style="width:46%;vertical-align:middle;">
                      {{#each manual_credentials}}{{> credentialBox label=label value=value}}{{/each}}
                    </td>
                  </tr></table>
                </td>
              </tr></table>
            </td></tr>
          </table>
          <table role="presentation"><tr><td height="14" style="height:14px;"></td></tr></table>

          <table role="presentation" width="100%" style="width:100%;background:#fff0f2;border:1px solid #f9dfe5;border-radius:8px;">
            <tr><td style="padding:13px 16px;font-size:13px;line-height:21px;color:#46516a;"><strong style="color:#db253d;">Keep this email private.</strong> These secrets are not returned by the registration API. Do not share them with anyone.</td></tr>
          </table>
          <table role="presentation" width="100%" style="width:100%;margin-top:18px;border-top:1px solid #dfe5ef;">
            <tr>
              <td class="stack" width="64%" style="width:64%;padding-top:16px;font-size:13px;line-height:22px;vertical-align:top;">Regards,<br><strong>FlowupS Technologies Pvt. Ltd.</strong><br><span style="color:#535e76;">Sangamner, Maharashtra, India.</span></td>
              <td class="stack footer-contact" width="36%" style="width:36%;padding:16px 0 0 18px;font-size:13px;line-height:22px;vertical-align:top;"><a href="mailto:{{support_email}}" style="color:#1265f5;text-decoration:none;">{{support_email}}</a></td>
            </tr>
          </table>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
